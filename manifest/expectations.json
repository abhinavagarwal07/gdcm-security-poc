      "finding": 1,
      "title": "RLE overflow gives a controlled adjacent-object write and a controlled indirect branch",
      "site": "RLECodec::DecodeFragment, Source/MediaStorageAndFileFormat/gdcmRLECodec.cxx",
      "entry_point": "gdcm::ImageReader::Read",
      "sanitizer": "none",
      "kind": "exploit",
